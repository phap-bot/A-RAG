# ==========================================================
# ENTERPRISE AGENTIC RAG - ENVIRONMENT CONFIGURATION
# ==========================================================

# Application Settings
APP_NAME="Enterprise-Agentic-RAG-BaaS"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"
LOG_FORMAT_JSON=true

# API Server
API_HOST="0.0.0.0"
API_PORT=8000
API_PREFIX="/api/v1"

# LLM & Embedding Settings
OPENAI_API_KEY="sk-mock-key-replace-with-actual"
OPENAI_BASE_URL="https://api.openai.com/v1"
PRIMARY_LLM_MODEL="gpt-4o"
VLM_MODEL_NAME="gpt-4o"
EMBEDDING_MODEL_NAME="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# Agentic Reflection Loop
MAX_REFLECTION_RETRIES=3

# Vector Database (Qdrant)
VECTOR_DB_PROVIDER="qdrant"
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="enterprise_kb"

# Graph Database (Neo4j)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password123"

# Cache & Message Broker (Redis)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# MCP Server
MCP_SERVER_NAME="knowledge-baas-mcp"
MCP_SERVER_HOST="0.0.0.0"
MCP_SERVER_PORT=8001

# Evaluation & Backlog
RAGAS_ENABLED=true
BACKLOG_DIR="backlog"
