# ==========================================================
# ENTERPRISE AGENTIC RAG - ENVIRONMENT CONFIGURATION
# ==========================================================

# Application Settings
APP_NAME="Enterprise-Agentic-RAG-BaaS"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"
LOG_FORMAT_JSON=true

# Browser session security. Use a long random value outside local development.
SESSION_SECRET="replace-with-a-long-random-session-secret"
SESSION_COOKIE_SECURE=false

# API Server
API_HOST="0.0.0.0"
API_PORT=8010
API_PREFIX="/api/v1"
CORS_ALLOW_ORIGIN_REGEX="^https?://(localhost|127\\.0\\.0\\.1)(:\\d+)?$"

# LLM & Embedding Settings
OPENAI_API_KEY="sk-mock-key-replace-with-actual"
# Zone 2 agents use deterministic tool-aware fallbacks until this is enabled.
AGENT_LLM_ENABLED=false
OPENAI_BASE_URL="https://api.openai.com/v1"
PRIMARY_LLM_MODEL="gpt-4o"
VLM_MODEL_NAME="gpt-4o"
EMBEDDING_MODEL_NAME="BAAI/bge-m3"
EMBEDDING_DIMENSION=1024

# Agentic Reflection Loop
MAX_REFLECTION_RETRIES=3
MAX_AGENT_HANDOFFS=12
MAX_TOOL_ROUNDS_PER_AGENT=6

# Vector and Graph Storage (Neo4j local)
VECTOR_DB_PROVIDER="neo4j"

# Graph Database (Neo4j)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password123"
NEO4J_DATABASE="neo4j"
NEO4J_VECTOR_INDEX="chunk_embedding_bge_m3"
NEO4J_FULLTEXT_INDEX="chunk_content_fulltext"
NEO4J_VECTOR_QUERY_MODE="search"
NEO4J_ENABLED=false
NEO4J_AUTO_SCHEMA=true
NEO4J_CONNECTION_TIMEOUT_SECONDS=10
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_VECTOR_OVERSAMPLING=5
NEO4J_RRF_K=60
RETRIEVAL_TOP_K=5
RETRIEVAL_PARALLEL_WORKERS=4
NEO4J_GRAPH_MAX_HOPS=2
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=40
EMBEDDING_ENABLED=true
EMBEDDING_PROVIDER="bge_m3"
EMBEDDING_BATCH_SIZE=64
# Force local BGE-M3 inference onto CUDA; startup fails if CUDA is unavailable.
EMBEDDING_DEVICE="cuda"
EMBEDDING_NORMALIZE=true
EMBEDDING_CACHE_DIR=".models"

# Cache & Message Broker (Redis)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"
INGESTION_WORKER_COUNT=1

# MCP Server
MCP_SERVER_NAME="knowledge-baas-mcp"
MCP_SERVER_HOST="0.0.0.0"
MCP_SERVER_PORT=8001

# Evaluation & Backlog
RAGAS_ENABLED=true
BACKLOG_DIR="backlog"

# MinerU API (Zone 1 document parsing)
MINERU_BASE_URL="http://localhost:8000"
MINERU_API_KEY=""
MINERU_BACKEND="pipeline"
MINERU_PARSE_METHOD="auto"
MINERU_TIMEOUT_SECONDS=600
MINERU_MAX_RETRIES=2
MINERU_RETRY_BACKOFF_SECONDS=1
MINERU_ARTIFACT_DIR=".artifacts/mineru"
